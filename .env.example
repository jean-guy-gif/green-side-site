# Copier ce fichier en .env.local — ne jamais versionner .env.local.

# "demo" (défaut) ou "production". Voir README, « Les deux modes ».
NEXT_PUBLIC_SITE_MODE=demo

# Adresse publique du site, sans barre finale (ex. https://www.domaine.fr).
# Sur Vercel, l'adresse du projet est utilisée tant que cette variable est absente.
NEXT_PUBLIC_SITE_URL=

# Adresse qui reçoit les demandes des formulaires (e-mail, CRM, automatisation).
# Sans elle, les formulaires annoncent qu'ils ne transmettent rien.
LEADS_WEBHOOK_URL=
# Facultatif : jeton envoyé dans l'en-tête Authorization: Bearer …
LEADS_WEBHOOK_SECRET=
